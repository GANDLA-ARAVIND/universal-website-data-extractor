# Application Settings
PROJECT_NAME="Universal Website Data Extractor"
VERSION="0.1.0"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration
# Set USE_SQLITE=true for instant local dev without running PostgreSQL
USE_SQLITE=true
SQLITE_DB_PATH="./web_scraper.db"

# PostgreSQL Async Credentials (used if USE_SQLITE=false)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="web_scraper_db"

# Crawler Defaults & Free-Tier Bounds
DEFAULT_MAX_DEPTH=2
DEFAULT_MAX_PAGES=50
DEFAULT_CRAWL_DELAY_SEC=0.5
FETCH_TIMEOUT_SEC=15.0
PLAYWRIGHT_HEADLESS=true
MAX_SINGLE_CRAWL_PAGES=250
MAX_BATCH_WEBSITES=25
MAX_RESPONSE_SIZE_BYTES=10485760

# AI Phase Settings
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
EMBEDDING_MODEL="gemini-embedding-001"
ALLOW_AI_MOCK_FALLBACK=false
