# Application Settings
PROJECT_NAME="Universal Website Data Extractor"
VERSION="0.1.0"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration
# Set USE_SQLITE=true for instant local dev without running PostgreSQL
USE_SQLITE=true
SQLITE_DB_PATH="./web_scraper.db"

# PostgreSQL Async Credentials (used if USE_SQLITE=false)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="web_scraper_db"

# Crawler Defaults
DEFAULT_MAX_DEPTH=2
DEFAULT_MAX_PAGES=50
DEFAULT_CRAWL_DELAY_SEC=0.5
FETCH_TIMEOUT_SEC=15.0
PLAYWRIGHT_HEADLESS=true
